              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            },
            "description": "Prueba de paginacion: confirma que pedir la pagina 2 devuelve usuarios distintos a los de la pagina 1."
          },
          "response": []
