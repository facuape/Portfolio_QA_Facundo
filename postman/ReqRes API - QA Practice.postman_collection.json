    {
      "name": "AUTENTICACION",
      "item": [
        {
          "name": "Bearer Token - autenticacion exitosa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Server confirms the token was authenticated\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    pm.expect(json.authenticated).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token echoed back matches the one sent\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    pm.expect(json.token).to.eql(pm.collectionVariables.get(\"token\"));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://httpbingo.org/bearer",
              "protocol": "https",
              "host": [
                "httpbingo",
                "org"
              ],
              "path": [
                "bearer"
              ]
            },
            "description": "httpbingo.org/bearer devuelve 200 y {authenticated: true, token: \"...\"} para cualquier Authorization: Bearer <token> valido. Es un port en Go de httpbin.org (mismo formato de respuesta), mantenido activamente y mas confiable que el httpbin.org original. Sirve para practicar el flujo de Bearer Token sin depender de que reqres.in lo soporte (reqres solo acepta x-api-key)."
          },
          "response": []
        }
      ]
    }
