        {
          "name": "Crear usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has id and createdAt\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    pm.expect(json.id).to.exist;\r",
                  "    pm.expect(json.createdAt).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Name matches what was sent\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    pm.expect(json.name).to.eql(\"Facundo\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Facundo\",\r\n  \"job\": \"QA Tester\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has a non-empty data array\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    pm.expect(json.data).to.be.an(\"array\");\r",
                  "    pm.expect(json.data.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each user has id and email\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    json.data.forEach(function (user) {\r",
                  "        pm.expect(user.id).to.exist;\r",
                  "        pm.expect(user.email).to.exist;\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar usuarios - pagina 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response page matches requested page\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    pm.expect(json.page).to.eql(2);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Users on page 2 are different from page 1\", function () {\r",
                  "    var json = pm.response.json();\r",
                  "    var idsOnPage2 = json.data.map(function (u) { return u.id; });\r",
                  "    pm.expect(idsOnPage2).to.not.include(1);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users?page=2",
